# ── Nexora Studio environment ──────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4100
APP_NAME=Nexora Studio
APP_DOMAIN=nexora.studio
FRONTEND_URL=http://localhost:5174

# Replace this with a long, random value in production.
JWT_SECRET=replace-me-with-a-long-random-secret

# SQLite database and local uploads
DB_PATH=./data/nexora.db
UPLOAD_DIR=./data/uploads

# Seeded platform administrator
SUPER_ADMIN_EMAIL=admin@nexora.studio
SUPER_ADMIN_PASSWORD=Platform123!

# ── Optional external AI provider ───────────────────────────────────────────
# Any OpenAI-compatible chat completions endpoint works. When AI_API_KEY is
# empty, every agent uses its deterministic local reasoning implementation.
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
