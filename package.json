{
  "name": "nexora-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nexora Studio — multi-tenant AI website builder SaaS",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite --config client/vite.config.ts\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test:smoke": "node server/tests/smoke.test.js",
    "test:ui": "node scripts/ui-flow.mjs",
    "test:templates": "node scripts/templates-check.mjs",
    "test:catalog": "node scripts/validate-templates.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
